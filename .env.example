# Copy to .env.local and fill in real values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database tests (npm run test:db) refuse to run unless this matches the URL above. Use your DEV project ref only.
DB_TEST_PROJECT_REF=

# Public https address of the site, used in emailed links (confirm email, reset password). Local dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# The storefront shows a "Demo catalogue" notice while the DEMO seed is the catalog. Set to "off" when the demo data is removed (launch checklist in docs/ROADMAP.md).
DEMO_CATALOG_NOTICE=

# Owner e-mail for every new order (docs/ORDERS.md). Server only: never prefix with NEXT_PUBLIC_. The recipient addresses are set in Admin > Settings, not here.
RESEND_API_KEY=
# Sender, for example: Umar Siddique Traders <orders@your-verified-domain>. Empty = Resend's test sender (delivers only to your own Resend account address).
RESEND_FROM_EMAIL=
